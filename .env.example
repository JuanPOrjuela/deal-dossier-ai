# Copy this file to .env and fill in real values. Never commit .env.
#
# --- Supabase (frontend, safe to expose -- protected by RLS) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- LemonSqueezy (frontend, safe to expose -- these are just checkout links) ---
# Your store's checkout subdomain, e.g. https://cloud-ais.lemonsqueezy.com
VITE_LEMONSQUEEZY_STORE_URL=https://YOUR_STORE.lemonsqueezy.com
# Variant IDs from the 3 products you create in the LemonSqueezy dashboard
# (Products -> [product] -> Variants -> copy the numeric ID). See README
# setup checklist for exact product settings.
VITE_LEMONSQUEEZY_VARIANT_SINGLE=000000
VITE_LEMONSQUEEZY_VARIANT_ALL_ACCESS=000000
VITE_LEMONSQUEEZY_VARIANT_LIFETIME=000000

# ---------------------------------------------------------------------------
# The variables below are SERVER-SIDE ONLY. Never prefix them with VITE_
# (that would ship them to the browser). Set these as Supabase Edge Function
# secrets, e.g.:
#   supabase secrets set LEMONSQUEEZY_WEBHOOK_SECRET=... LEMONSQUEEZY_VARIANT_SINGLE=... ...
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically to
# every Edge Function by Supabase -- you do not set those yourself.
# ---------------------------------------------------------------------------
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-signing-secret
LEMONSQUEEZY_VARIANT_SINGLE=000000
LEMONSQUEEZY_VARIANT_ALL_ACCESS=000000
LEMONSQUEEZY_VARIANT_LIFETIME=000000
